#include <iostream>
using namespace std;

int main() {
    int a, b;

    // Input two numbers
    cout << "Enter two numbers: ";
    cin >> a >> b;

    // Declare pointers
    int *p1 = &a;
    int *p2 = &b;

    // Swap using pointers
    int temp = *p1;
    *p1 = *p2;
    *p2 = temp;

    // Output swapped values
    cout << "After swapping:" << endl;
    cout << "a = " << a << endl;
    cout << "b = " << b << endl;

    return 0;
}
